{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.codex/brain-hooks/session-start-hook.mjs",
            "timeout": 20,
            "statusMessage": "Loading brain memory context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.codex/brain-hooks/stop-hook.mjs",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
