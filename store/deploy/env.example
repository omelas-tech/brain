# Copy to .env and fill in:  cp env.example .env
# Never commit the real file.

# Two DNS names that point at this host. Caddy gets certificates for them.
STORE_DOMAIN=store.example.com
MCP_DOMAIN=mcp.example.com

# Encrypts archives at rest. Generate with:
#   docker compose run --rm store keygen
# Keep a copy somewhere safe: without it the stored archives cannot be read.
STORE_ENCRYPTION_KEY=

# Encrypts the connector's saved logins (so users are not logged out on restart).
# Generate with:  openssl rand -hex 32
CONNECTOR_STATE_KEY=

# Optional limits.
STORE_MAX_UPLOAD_MB=50
STORE_MAX_USER_MB=0
